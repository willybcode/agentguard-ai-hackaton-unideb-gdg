# AgentGuard configuration — copy to .env and fill in.
# .env is gitignored; this file is the documented template.
#
# Both models are served by one OpenAI-compatible proxy. The proxy owns
# upstream selection and fallback ordering.

# ---------------------------------------------------------------------------
# One API: the local proxy.
# ---------------------------------------------------------------------------
AG_API_URL=http://localhost:4010/v1
AG_API_KEY=sk-your-proxy-key

# The planner: a regular chat model that returns JSON tool-call plans.
AG_MODEL=your-provider/your-chat-model
AG_MODEL_TYPE=regular

# ---------------------------------------------------------------------------
# Optional second opinion. A decision model (Liquid d1-2B / d1-3B) reads the
# proposed call and returns calibrated probabilities. It can only tighten the
# policy verdict, never loosen it. Leave AG_ADJUDICATOR_MODEL empty to disable.
# ---------------------------------------------------------------------------
AG_ADJUDICATOR_MODEL=
AG_ADJUDICATOR_TYPE=decision
# Only needed when the proxy cannot route decision calls.
# AG_DECISION_URL=http://localhost:1234/v1/decisions
AG_DECISION_THRESHOLD=0.5

# ---------------------------------------------------------------------------
# Fallback. If the endpoint is unreachable, degrade to the built-in mock planner
# instead of failing. Transport errors only — a malformed response still raises.
# ---------------------------------------------------------------------------
# Reasoning models think before answering: latency and tokens spent before the
# first JSON character. "none" removed reasoning entirely on the proxy
# (137 -> 20 completion tokens); "off" omits the field for models that reject it.
# If the field is ignored the model still works — it just spends more.
AG_REASONING_EFFORT=none

# Planning budget. Generous because a model that ignores AG_REASONING_EFFORT
# will spend most of it thinking; too small yields finish_reason=length and no
# content ("no answer before the token budget ran out").
AG_MAX_TOKENS=8192
# Port for `python -m ag serve`; --port overrides it.
AG_DEMO_PORT=8060
AG_FALLBACK_TO_MOCK=true
AG_TIMEOUT=60
